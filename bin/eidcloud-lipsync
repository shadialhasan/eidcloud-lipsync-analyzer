#!/usr/bin/env php
<?php

declare(strict_types=1);

// Auto-register PSR-4 autoloader for standalone execution without Composer install
spl_autoload_register(function (string $class) {
    $prefix = 'EidCloud\\LipsyncAnalyzer\\';
    $baseDir = dirname(__DIR__) . '/src/';

    $len = strlen($prefix);
    if (strncmp($prefix, $class, $len) !== 0) {
        return;
    }

    $relativeClass = substr($class, $len);
    $file = $baseDir . str_replace('\\', '/', $relativeClass) . '.php';

    if (file_exists($file)) {
        require_once $file;
    }
});

use EidCloud\LipsyncAnalyzer\LipsyncAnalyzer;

function printHelp(): void {
    echo <<<HELP
\033[1;36m👄 eidcloud-lipsync\033[0m - Audio-Video Lip-Sync Alignment & Quality Analyzer v1.0.0

\033[1;33mUSAGE:\033[0m
  php bin/eidcloud-lipsync <command> <video-path> [options]

\033[1;33mCOMMANDS:\033[0m
  \033[1;32manalyze\033[0m     Analyze audio-to-video drift, lip-sync score, and alignment
  \033[1;32mtimeline\033[0m    Generate an SVG visual comparison timeline of audio vs mouth motion

\033[1;33mOPTIONS:\033[0m
  \033[1;32m--json\033[0m             Output results in JSON format
  \033[1;32m--out=<file.svg>\033[0m   Specify output file for SVG timeline (default: sync_timeline.svg)
  \033[1;32m--rate=<hz>\033[0m        Sampling rate in Hz (default: 50.0 = 20ms resolution)
  \033[1;32m--max-sec=<sec>\033[0m    Maximum seconds of media to analyze
  \033[1;32m-h, --help\033[0m         Show this help message

\033[1;33mEXAMPLES:\033[0m
  php bin/eidcloud-lipsync analyze interview.mp4
  php bin/eidcloud-lipsync analyze interview.mp4 --json
  php bin/eidcloud-lipsync timeline interview.mp4 --out=alignment.svg
  php bin/eidcloud-lipsync analyze presentation.mp4 --rate=100 --max-sec=10

HELP;
}

$argv = $_SERVER['argv'];
$argc = count($argv);

if ($argc < 2 || in_array('-h', $argv) || in_array('--help', $argv)) {
    printHelp();
    exit(0);
}

$command = $argv[1];
$videoPath = null;
$isJson = false;
$outFile = null;
$rateHz = 50.0;
$maxSec = null;

for ($i = 2; $i < $argc; $i++) {
    $arg = $argv[$i];
    if ($arg === '--json') {
        $isJson = true;
    } elseif (str_starts_with($arg, '--out=')) {
        $outFile = substr($arg, 6);
    } elseif (str_starts_with($arg, '--rate=')) {
        $rateHz = (float) substr($arg, 7);
    } elseif (str_starts_with($arg, '--max-sec=')) {
        $maxSec = (float) substr($arg, 10);
    } elseif (!str_starts_with($arg, '-') && $videoPath === null) {
        $videoPath = $arg;
    }
}

if ($videoPath === null) {
    fwrite(STDERR, "\033[1;31mError:\033[0m Missing media file path.\nRun with --help for usage.\n");
    exit(1);
}

if (!file_exists($videoPath)) {
    fwrite(STDERR, "\033[1;31mError:\033[0m File not found: {$videoPath}\n");
    exit(1);
}

try {
    $analyzer = new LipsyncAnalyzer();

    if ($command === 'analyze') {
        $result = $analyzer->analyze($videoPath, $rateHz, $maxSec);

        if ($isJson) {
            echo $result->toJson(true) . PHP_EOL;
            exit(0);
        }

        $color = match ($result->category) {
            'Perfect' => "\033[1;32m",
            'Acceptable' => "\033[1;34m",
            'Noticeable Delay' => "\033[1;33m",
            default => "\033[1;31m",
        };
        $reset = "\033[0m";

        echo "=========================================================\n";
        echo "👄 \033[1mEidCloud Lip-Sync Alignment Analysis\033[0m\n";
        echo "=========================================================\n";
        echo sprintf(" File:              %s\n", basename($videoPath));
        echo sprintf(" Duration Analyzed: %.2f seconds (%d samples)\n", $result->durationSeconds, count($result->audioEnvelope));
        echo sprintf(" Sampling Rate:     %.1f Hz (%.1f ms window)\n", $result->samplingRateHz, 1000.0 / $result->samplingRateHz);
        echo "---------------------------------------------------------\n";
        echo sprintf(" Sync Drift:        \033[1m%+.2f ms\033[0m (%+.4f sec)\n", $result->driftMs, $result->driftMs / 1000.0);
        echo sprintf(" Status Category:   %s%s%s\n", $color, $result->category, $reset);
        echo sprintf(" Quality Score:     %s%.1f / 100%%%s\n", $color, $result->score, $reset);
        echo sprintf(" Correlation Peak:  %.4f\n", $result->correlationPeak);
        echo "=========================================================\n";
        exit(0);

    } elseif ($command === 'timeline') {
        $destination = $outFile ?? 'sync_timeline.svg';
        $analyzer->generateTimeline($videoPath, $destination, $rateHz, $maxSec);

        if ($isJson) {
            echo json_encode(['status' => 'success', 'output_file' => $destination]) . PHP_EOL;
        } else {
            echo "\033[1;32mSuccess:\033[0m Lip-sync SVG timeline rendered to: {$destination}\n";
        }
        exit(0);

    } else {
        fwrite(STDERR, "\033[1;31mError:\033[0m Unknown command '{$command}'. Supported commands: analyze, timeline\n");
        exit(1);
    }

} catch (Throwable $e) {
    fwrite(STDERR, "\033[1;31mAnalysis Error:\033[0m " . $e->getMessage() . PHP_EOL);
    exit(1);
}
